# Copy this file to .env and paste YOUR bot token from @BotFather
BOT_TOKEN=123456789:AAExample_ReplaceWithYourTokenFromBotFather

# Force-subscribe channel: users must join it before the bot searches.
# IMPORTANT: add the bot as an ADMIN in that channel, otherwise it cannot
# verify memberships and the gate auto-disables (bot keeps working).
CHANNEL_USERNAME=@gifthubai
CHANNEL_URL=https://t.me/gifthubai
